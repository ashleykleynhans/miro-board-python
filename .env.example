# Create a Miro developer app (https://developers.miro.com) to get an access token.
# For a quick test you can use the "Miro REST API" token from your board's share menu,
# or an OAuth access token from a developer app.
MIRO_ACCESS_TOKEN=your_miro_access_token

# Board id: the numeric id in the board URL (e.g. https://miro.com/app/board/uxXXXXXXXXXXXXX/)
MIRO_BOARD_ID=your_board_id
